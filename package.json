{
  "name": "siriskills",
  "version": "0.1.0",
  "description": "Validate, scaffold and template Siri app skills (SKILL.md in Skills.skillsbundle). CLI + MCP server + 40 example skills.",
  "type": "module",
  "bin": { "siriskills": "bin/siriskills.js" },
  "exports": {
    ".": "./src/index.js",
    "./validate": "./src/validate.js"
  },
  "files": ["bin", "src", "skills", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test",
    "validate": "node bin/siriskills.js validate skills --strict",
    "readme": "node scripts/build-readme.js",
    "check": "npm test && npm run validate && node scripts/build-readme.js --check"
  },
  "engines": { "node": ">=18" },
  "keywords": ["siri", "siri-ai", "app-intents", "skills", "skill-md", "skillsbundle", "ios", "xcode", "mcp", "mcp-server", "apple-intelligence"],
  "homepage": "https://siriskills.com",
  "repository": { "type": "git", "url": "git+https://github.com/HenryAgentTeam/awesome-siri-skills.git" },
  "bugs": "https://github.com/HenryAgentTeam/awesome-siri-skills/issues",
  "license": "MIT",
  "mcpName": "io.github.HenryAgentTeam/siriskills",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  }
}
